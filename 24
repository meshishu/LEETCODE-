class Solution {
public:
    ListNode* swapPairs(ListNode* head) {
        if (head == nullptr || head->next == nullptr) return head;

        ListNode* curr = head;
        ListNode* prev = nullptr;
        head = head->next;

        while (curr != nullptr) {
            ListNode* next = curr->next;

            if (next != nullptr) {
                curr->next = next->next;
                next->next = curr;

                if (prev != nullptr) prev->next = next;

                prev = curr;
                curr = curr->next;
            } else {
                curr = curr->next;
            }
        }

        return head;
    }
};
